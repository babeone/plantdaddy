# Copia questo file in .env e compila i valori.
# In SvelteKit solo le variabili con prefisso PUBLIC_ sono esposte al client:
# tutte le altre restano sul server.

# --- Database ---
DATABASE_URL=postgres://plantdaddy:cambiami@localhost:5432/plantdaddy

# --- Web Push (VAPID) ---
# Genera la coppia con:  npx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contatto richiesto dai push service: mailto: oppure un URL del sito.
VAPID_SUBJECT=mailto:tu@example.com

# --- Fuso orario applicativo ---
# Decide qual è "oggi" per le date delle cure. Il container gira in UTC: senza
# questo, un'annaffiatura registrata alle 00:30 italiane finirebbe al giorno
# precedente. Default: Europe/Rome.
APP_TIMEZONE=Europe/Rome

# --- Origine pubblica (produzione) ---
# adapter-node la usa per costruire le URL assolute dietro il reverse proxy, e
# SvelteKit per verificare l'header Origin delle form POST del pannello admin.
# Senza, la ricava da PROTOCOL_HEADER/host: funziona dietro Traefik, ma è meglio
# non lasciarlo a un'inferenza.
ORIGIN=https://plantdaddy.example.com

# --- Reverse proxy (produzione) ---
# Il rate limit su /api/session legge l'IP dal valore PIÙ A DESTRA di
# x-forwarded-for, perché Traefik lo appende in coda e il client può falsificare
# i valori precedenti. Se preferisci usare getClientAddress() di adapter-node,
# imposta queste due e adatta rate-limit.ts:
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# --- Cron notifiche giornaliere ---
# Segreto condiviso che l'endpoint di invio richiede in header, così solo il
# cron di Dokploy può farlo scattare. Genera con: openssl rand -hex 32
CRON_SECRET=

# --- Pannello di controllo admin (facoltativo, spento per default) ---
# Senza ADMIN_ENABLED=true ogni rotta del pannello risponde 404. È voluto: chi
# clona questo repository non si ritrova un'area di amministrazione esposta.
#
# Primo amministratore:  npm run admin:hash -- --insert
# Manutenzione e recupero della 2FA:  db/admin/insert-admin.sql
# ADMIN_ENABLED=true

# Percorso pubblico del pannello. NON è una misura di sicurezza: ha il prefisso
# PUBLIC_ perché serve anche all'hook reroute lato browser, quindi finisce nel
# bundle servito ai client. Cambiarlo toglie solo rumore dai log.
# PUBLIC_ADMIN_PATH=/superman

# IP esatti separati da virgola. Se valorizzata, tutto il resto riceve 404 prima
# ancora che venga letta una riga dal database. Niente CIDR: per reti intere ci
# sono firewall e VPN.
# ADMIN_IP_ALLOWLIST=1.2.3.4

# Mostra il testo libero scritto dagli utenti (note delle piante e degli eventi).
# Per default viene solo contato: il pannello serve a sapere se l'app funziona,
# non a leggere gli appunti di qualcuno.
# ADMIN_SHOW_USER_TEXT=true

# Durata massima della sessione admin, in ore (default 8). L'inattività chiude
# comunque la sessione dopo 30 minuti.
# ADMIN_SESSION_HOURS=8

# --- Archivio foto (RustFS, o qualunque server S3) ---
# Senza queste, le API delle foto rispondono 503 e il resto dell'app funziona
# normalmente: si può usare PlantDaddy anche senza foto.
#
# In produzione l'endpoint è il nome del service Docker, raggiungibile solo dalla
# rete interna: l'archivio non va pubblicato su internet. Le immagini passano dal
# proxy dell'app (/api/photos/...), quindi la CSP resta img-src 'self'.
S3_ENDPOINT=http://plantdaddy-rustfs:9000
S3_BUCKET=plantdaddy
# Con RustFS queste sono anche le credenziali PRINCIPALI dello storage: RustFS non
# ha CLI né API per creare una chiave con permessi limitati al solo bucket
# (rustfs/rustfs#1571), quindi l'app usa quelle. Chi le ha in mano può anche
# cancellare il bucket e creare altre chiavi: vanno trattate di conseguenza.
# Quando quell'issue sarà chiusa, si torna a una chiave limitata cambiando solo
# queste due righe.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# RustFS non ha regioni ma il protocollo pretende un valore per firmare.
S3_REGION=us-east-1

# Upload per utente al giorno. Gli slot limitano quante foto sono conservate
# insieme; questo limita il churn di chi cancella e ricarica all'infinito.
PHOTO_UPLOADS_PER_DAY=10

# --- Pannello di controllo (facoltativo) ---
# Senza ADMIN_ENABLED=true ogni rotta del pannello risponde 404.
# ADMIN_ENABLED=true
# PUBLIC_ADMIN_PATH=/superman
# ADMIN_IP_ALLOWLIST=
# ADMIN_SHOW_USER_TEXT=false
# Foto delle piante degli utenti visibili nel pannello (avatar e diario). Se non
# impostata EREDITA da ADMIN_SHOW_USER_TEXT: sono la stessa categoria, contenuto
# caricato dalle persone che usano l'app. Impostarla esplicitamente vince
# sull'ereditarietà, in entrambe le direzioni.
# Con le foto spente gli id non lasciano nemmeno il database e la rotta che le
# serve risponde 404, non 403.
# ADMIN_SHOW_USER_PHOTOS=false
# ADMIN_SESSION_HOURS=8

# --- Origine pubblica (produzione) ---
# Identica a quello che si legge nella barra degli indirizzi, con https:// e
# senza percorso. Se non combacia, le form del pannello rispondono
# "Cross-site POST form submissions are forbidden": vedi DEPLOY.md.
ORIGIN=https://plantdaddy.example.com

# --- Metriche e osservabilità ---
# Latenza ed errori per endpoint, visibili nel pannello di controllo alla scheda
# "Metriche". Non salvano IP, user agent, query string né corpi di richiesta: solo
# route id di SvelteKit, metodo, status, durata e un booleano autenticato/anonimo.
#
# METRICS_ENABLED=false disattiva tutto con overhead zero: il primo `if` dell'hook
# esce prima di qualunque calcolo. Misurato acceso: +0,013 ms sulla media per
# richiesta, +0,025 ms sul p95.
# METRICS_ENABLED=true

# Frazione di richieste registrate, 0-1. A 10.000 richieste al giorno non c'è
# motivo di campionare e i numeri restano esatti.
# I 5xx e le richieste oltre METRICS_ALWAYS_ABOVE_MS passano SEMPRE al 100%,
# qualunque sia questo valore: sono gli unici dati per cui la dashboard esiste.
# METRICS_SAMPLE_RATE=1.0
# METRICS_ALWAYS_ABOVE_MS=1000

# Buffer in memoria: tetto fisso di record prima del flush. 500 record sono
# ~125 KB. Quando è pieno e un flush è già in volo, i più vecchi vengono SCARTATI:
# è voluto, l'alternativa sarebbe far crescere la RAM senza limite.
# METRICS_BUFFER_MAX=500
# METRICS_FLUSH_MS=10000

# Retention. Grezzi dettagliati per giorni, poi solo aggregati orari, poi giornalieri.
# METRICS_RAW_DAYS=7
# METRICS_HOURLY_DAYS=90
# METRICS_DAILY_DAYS=365

# Tetto di sicurezza sulle righe grezze, indipendente dalla retention temporale:
# copre il caso di un picco che riempie il disco prima che i giorni passino.
# Misurato: 219 byte per riga inclusi i tre indici, quindi 2 milioni di righe sono
# circa 420 MB. Abbassalo se il disco è più stretto di così.
# METRICS_MAX_RAW_ROWS=2000000

# Soglia oltre la quale una risposta, anche riuscita, NON entra nel calcolo della
# latenza media e dei percentili: viene contata a parte come "oltre soglia" e
# mostrata nel suo riquadro e nel suo grafico.
#
# Serve perché la media è fragile: misurato su 200 risposte da ~50 ms più una sola
# rimasta appesa a 30 secondi, la media su tutte diceva 320 ms, quella sulle
# riuscite 50 ms. Il primo numero non descriveva niente di reale.
#
# Tienila ben SOPRA METRICS_ALWAYS_ABOVE_MS: quella decide cosa registrare sempre,
# questa cosa considerare un valore anomalo. Il massimo assoluto resta calcolato su
# tutte le richieste, quindi la peggiore è comunque visibile.
# METRICS_TIMEOUT_MS=10000
